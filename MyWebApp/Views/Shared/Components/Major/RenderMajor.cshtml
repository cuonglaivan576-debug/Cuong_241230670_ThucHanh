@model IEnumerable<Major>
<ul class="nav">
    @* [BỔ SUNG] mục "Tất cả" (không có id) để quay lại danh sách đầy đủ sau khi lọc *@
    <li class="nav-item"><a class="nav-link" role="button" style="cursor:pointer">Tất cả</a></li>
    @foreach (var m in Model)
    {
        <li class="nav-item" id="@m.MajorID">
            <a class="nav-link" role="button" style="cursor:pointer">@m.MajorName</a>
        </li>
    }
</ul>
