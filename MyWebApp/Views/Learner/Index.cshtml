@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/MyLayoutHelper.cshtml";
}
@model IEnumerable<Learner>
<div class="ms-2 mx-2">
    <h1>Learner List</h1>

    @await Component.InvokeAsync("Major")

    <form id="searchForm" class="form-inline ms-auto me-0 my-2">
        <div class="input-group" style="max-width:320px">
            <input id="keyword" class="form-control" name="keyword" type="text" placeholder="Search learner" />
            <button id="btnSearch" class="btn btn-primary" type="button">
                <i class="fas fa-search"></i>
            </button>
        </div>
    </form>

    <div id="content">
        <partial name="LearnerTable" model="Model" />
    </div>

    <a asp-action="Create" class="btn btn-primary">Create New Student</a>
</div>

@section Scripts {
    <script>
        var filterUrl = '@Url.Action("LearnerFilter", "Learner")';

        function loadData(data) {
            $.ajax({
                url: filterUrl,
                data: data,
                success: function (response) {
                    $("div#content").html(response);
                }
            });
        }

        $('body').on('click', 'li.page-item', function () {
            loadData({
                mid: $(this).attr("mid"),
                keyword: $(this).attr("keyword"),
                pageIndex: $(this).attr("page")
            });
        });

        $(".nav li").click(function () {
            loadData({ mid: $(this).attr("id") });
        });

        $("button#btnSearch").click(function () {
            loadData({ keyword: $("#keyword").val() });
        });

        $("#searchForm").on("submit", function (e) {
            e.preventDefault();
            $("button#btnSearch").click();
        });
    </script>
}
